# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริงก่อนรัน docker compose up
# ** ห้าม commit ไฟล์ .env ขึ้น git (อยู่ใน .gitignore แล้ว) **

# development | production  (production จะตรวจ secret/CORS เข้มและไม่ยอมสตาร์ทถ้าตั้งค่าไม่ปลอดภัย)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Database ----------
POSTGRES_USER=dcc_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=detectcallcenter
# ใช้เชื่อมต่อฐานข้อมูลจาก service "backend" หา service "db" ใน docker-compose
DATABASE_URL=postgresql+psycopg2://dcc_user:change_me_strong_password@db:5432/detectcallcenter

# ---------- Auth ----------
# สร้างด้วยคำสั่ง: openssl rand -hex 32   (หรือ python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# ---------- CORS ----------
# origin ของ frontend ที่อนุญาต (คั่นด้วย comma) — ใน docker-compose frontend เรียก API ผ่าน nginx
# origin เดียวกันอยู่แล้ว ค่านี้จำเป็นเมื่อ frontend อยู่คนละโดเมน (เช่น deploy แยกบน cloud)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- อื่น ๆ ----------
# ที่อยู่โมดูล/บริการ AI จริง (ถ้ามี) สำหรับ endpoint /detect/audio
VOICEGUARD_AI_URL=http://voiceguard-ai:9000
APP_TIMEZONE=Asia/Bangkok
# สร้างผู้ใช้ทดลอง (admin/Admin1234, officer.demo/demo1234) + ข้อมูลตัวอย่าง — ตั้งเป็น false ใน production!
SEED_DEMO_DATA=true
